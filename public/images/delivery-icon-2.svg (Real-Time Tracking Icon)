<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
  <circle cx="50" cy="50" r="48" fill="#f8f9fa" stroke="#ff5a5f" stroke-width="2"/>
  
  <!-- Map Background -->
  <rect x="20" y="20" width="60" height="60" rx="3" fill="#ffffff" stroke="#ff5a5f" stroke-width="2"/>
  
  <!-- Map Elements -->
  <path d="M25,35 Q35,20,45,35 T65,35 T85,35" fill="none" stroke="#dddddd" stroke-width="2"/>
  <path d="M25,55 Q35,40,45,55 T65,55 T85,55" fill="none" stroke="#dddddd" stroke-width="2"/>
  
  <!-- Location Pin -->
  <path d="M50,38 c-5,0-9,4-9,9 c0,5,9,22,9,22 s9-17,9-22 C59,42,55,38,50,38z" fill="#ff5a5f"/>
  <circle cx="50" cy="47" r="3" fill="white"/>
  
  <!-- Pulse Circles -->
  <circle cx="50" cy="47" r="15" fill="none" stroke="#ff5a5f" stroke-width="1.5" opacity="0.3">
    <animate attributeName="r" from="15" to="25" dur="1.5s" begin="0s" repeatCount="indefinite"/>
    <animate attributeName="opacity" from="0.3" to="0" dur="1.5s" begin="0s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Pizza Delivery Car -->
  <rect x="30" y="65" width="12" height="8" rx="2" fill="#ff5a5f"/>
  <circle cx="33" cy="73" r="3" fill="#333333"/>
  <circle cx="39" cy="73" r="3" fill="#333333"/>
  
  <!-- Route Line -->
  <path d="M40,65 Q45,55,50,47" fill="none" stroke="#ff5a5f" stroke-width="1.5" stroke-dasharray="3,3"/>
</svg>